/**
 * @param {number[]} nums
 * @return {number}
 */
var maxSelectedElements = function(nums) {
    if (nums.length === 0) return 0;

    // Step 1: Map frequencies and find range
    const kk = new Map();
    let minV = Infinity;
    let maxV = -Infinity;

    for (const num of nums) {
        kk.set(num, (kk.get(num) || 0) + 1);
        if (num < minV) minV = num;
        if (num > maxV) maxV = num;
    }

    // Step 2: Initialize DP and G maps
    // dp[i] = longest chain ending at i
    // g[i] = longest chain ending at i, but with one 'i' spare/unused
    const dp = new Map();
    const g = new Map();
    let answer = 0;

    // Step 3: Iterate through the range
    // We go from minV to maxV + 1 because we can increment the largest number
    for (let i = minV; i <= maxV + 1; i++) {
        const currentCount = kk.get(i) || 0;
        const prevCount = kk.get(i - 1) || 0;

        // --- Calculate dp[i] ---
        if (currentCount >= 1) {
            dp.set(i, (dp.get(i - 1) || 0) + 1);
        } else if (prevCount >= 1) {
            // i is not in array, so we use a 'spare' from i-1
            dp.set(i, (g.get(i - 1) || 0) + 1);
        } else {
            dp.set(i, 0);
        }

        // --- Calculate g[i] ---
        if (currentCount >= 2) {
            // We have a spare i because count is at least 2
            g.set(i, (dp.get(i - 1) || 0) + 1);
        } else if (currentCount === 1) {
            // We have one i. To have a spare, i-1 must have passed us one
            if (prevCount >= 1) {
                g.set(i, (g.get(i - 1) || 0) + 1);
            } else {
                g.set(i, 0);
            }
        } else {
            g.set(i, 0);
        }

        answer = Math.max(answer, dp.get(i) || 0);
    }

    return answer;
};